# pgJDBC (Java JDBC driver): its own test suite, unmodified, at this exact commit.
UPSTREAM_REPO=https://github.com/pgjdbc/pgjdbc.git
UPSTREAM_REF=REL42.7.14
UPSTREAM_SHA=ebdd9d0a4017e74182eabb0cc304105a0120b647
# Upstream's public test credentials (build.properties), registered in ProxySQL; the first one is the
# user the connection proof uses. The ssl_test_* users are the roles SslTest creates itself, with the
# fixed passwords set in its source (SslTest.Role).
PROXYSQL_USERS="test:test postgres:postgres ssl_test_md5:ssl_test_pass_md5_role ssl_test_scram:ssl_test_pass_scram_role"
SUITE_DATABASE=test
# pgJDBC's test certificate is CN=localhost: the runner shares the target's network and connects to localhost
NETWORK_MODE=shared
LEG_TIMEOUT_MINUTES=60
