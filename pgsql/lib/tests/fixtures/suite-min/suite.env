# Minimal suite used by the pgsql/lib tests: its own PostgreSQL user and database, shared network.
PROXYSQL_USERS="alice:alicepw"
SUITE_DATABASE=alicedb
NETWORK_MODE=shared
LEG_TIMEOUT_MINUTES=5
# environment variables passed from run-suite.sh's caller to the runner (tests set FIXTURE_MODE)
RUNNER_PASS_ENV="FIXTURE_MODE"
